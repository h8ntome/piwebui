{
  "name": "pi-web-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Browser view and control surface over Pi sessions (independent project; Pi executes, pi-web renders and relays)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/shared",
    "packages/pi-adapter",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "build": "npm run gen:palette && npm run build -w @pi-web/shared && npm run build -w @pi-web/pi-adapter && npm run build -w @pi-web/server && npm run build -w @pi-web/client",
    "typecheck": "npm run build --workspaces --if-present",
    "dev:server": "npm run dev -w @pi-web/server",
    "dev:client": "npm run dev -w @pi-web/client",
    "start": "npm run start -w @pi-web/server",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "tsx scripts/run-tests.ts unit",
    "test:integration": "tsx scripts/run-tests.ts integration",
    "test:e2e": "tsx scripts/run-tests.ts e2e",
    "test:security": "tsx scripts/run-tests.ts security",
    "test:perf": "tsx scripts/run-tests.ts perf",
    "gen:palette": "tsx scripts/gen-palette.ts",
    "contrast:audit": "tsx scripts/contrast-audit.ts",
    "lint:client": "tsx scripts/lint-client.ts",
    "fixtures:gen": "tsx scripts/gen-fixtures.ts",
    "p0:verify": "tsx e2e/p0-capability-matrix.ts",
    "package:smoke": "tsx scripts/package-smoke.ts"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
